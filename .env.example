# Public values: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only. Never prefix with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SECRET_KEY=your-secret-or-service-role-key

# Optional base URL used by end-to-end tests.
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
